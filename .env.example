# Copy to .env.local for local work.
# On Cloudflare, set NEXT_PUBLIC_* values under the Worker's Settings > Build > Build variables and secrets
# (they are baked in when the site is built).

# Public address of the site (used for links in metadata), e.g. https://monthliv.<account>.workers.dev
# or the real domain once it is connected.
NEXT_PUBLIC_SITE_URL=

# Google Maps. Without a key the site uses an OpenStreetMap map (OpenFreeMap tiles, no key needed).
# Restrict the key to your domains (HTTP referrers) and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (needed for price pins). Empty uses Google's demo ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Let search engines index the site. Keep false until real prices and bookings are live.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Capacitor: which address the iOS and Android apps open (the live site, or a staging site).
CAP_SERVER_URL=
