rules_version = '2';

// monthliv — Cloud Firestore 규칙 (데모용)
// ------------------------------------------------------------------
// 지금 사이트는 로그인 없이 아이디만으로 들어가는 데모라서, 이 규칙은
// "사이트가 쓰는 컬렉션만, 정해진 날짜까지" 누구나 읽고 쓸 수 있게 합니다.
//  - 예시 데이터로 내부 테스트할 때만 쓰세요. 실제 고객 정보·예약을 받지 마세요.
//  - 날짜가 지나면 쓰기가 막힙니다(사이트는 읽기 전용으로 바뀜). 필요하면 날짜를 늘리세요.
//  - 실서비스 전에는 Firebase Authentication을 붙이고 이용자·점주·본사 역할별 규칙으로 바꿔야 합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function appCollection(col) {
      return col in ['branches', 'rooms', 'bookings', 'members', 'owners', 'coupons', 'wallet', 'tours', 'logs', 'i18n'];
    }
    match /{col}/{docId} {
      allow read: if appCollection(col);
      allow write: if appCollection(col) && request.time < timestamp.date(2027, 3, 31);
    }
  }
}
